__pycache__/
*.pyc
.DS_Store

# secrets
.env

# Regenerated by `run.py splits make` / `splits make-dt` (deterministic, ~400 MB)
data_splits/
# Evaluation-time copies of tools_splits/ and results of ad-hoc reruns
tools_splits_dt/
logs/

# data_dtg/ tracks only what amplification produced; `run.py augment link`
# copies data/'s programs back in
data_dtg/*/*/buggy/
data_dtg/*/*/correct/
data_dtg/*/*/reference.py

# Refactory's replication package, cloned in place to re-run that baseline
baselines/refactory/
