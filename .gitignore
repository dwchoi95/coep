__pycache__/
*.pyc

# secrets
.env

# LaTeX build products; the PDFs and .bbl are kept so each track is readable
# and submittable straight from a clone
paper/*.aux
paper/*.log
paper/*.fls
paper/*.fdb_latexmk
paper/*.blg
paper/*.out
paper/*.synctex.gz

# Code and Data Packages are built by `run.py package <track>`
artifact/code_and_data/
artifact/code_and_data.zip

# Refactory's replication package, cloned in place. It is its own git repo and
# 36 MB of the authors' data, so it is not vendored here; clone
# githubhuyang/refactory into baselines/ to re-run that baseline.
baselines/refactory/

# stray pdflatex output from running outside paper/
texput.log

# macOS
.DS_Store

# BRAFAR and MENTORED, cloned in place like Refactory (each is its own git repo);
# our adapter diffs, dataset builder and run scripts live in baselines/adapters/
baselines/brafar/
baselines/mentored/

# Regenerated by `run.py splits make` / `splits make-dt` (deterministic, ~400 MB)
data_splits/
# Evaluation-time copies of tools/ and tools_splits/ (their sl/ staging is per run)
tools_dt/
tools_dt_ctrl/
tools_splits_dt/
logs/
# Third-party papers kept beside the writing guidelines, not redistributed
paper/guidelines/*.pdf
# data_dt*/ track only what amplification produced; `run.py augment link`
# copies data/'s programs back in
data_dt/*/buggy/
data_dt/*/correct/
data_dt/*/reference.py
data_dtg/*/*/buggy/
data_dtg/*/*/correct/
data_dtg/*/*/reference.py
