__pycache__/
*.pyc
.DS_Store

# secrets
.env

# Regenerated by `run.py splits make` (deterministic, ~400 MB): the splits,
# their suites, and the tool copies their evaluation runs on
splits_work/
logs/

# Refactory's replication package, cloned in place to re-run that baseline.
# It is its own git repo and 36 MB of the authors' data, so it is not vendored.
baselines/refactory/

# LaTeX build products
paper/*.aux
paper/*.log
paper/*.fls
paper/*.fdb_latexmk
paper/*.blg
paper/*.out
paper/*.synctex.gz
texput.log

# Third-party papers kept beside the writing guidelines, not redistributed
paper/guidelines/*.pdf

# BRAFAR and MENTORED, cloned in place for the archived runs
# (archive/baselines/adapters/ holds our adapter diffs and run scripts)
baselines/brafar/
baselines/mentored/

# Re-run logs and job scripts of the contract re-runs (scratch; the promoted
# results live under results/)
results/contract/

# Data roots of the rebuilds: links into benchmark/ and tools/rebuild/
rebuild_work/
