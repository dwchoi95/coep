{
  "id": "refactory_q1",
  "entry": "search",
  "description": "Task: Sequential Search",
  "tests": [
    {
      "args": [
        42,
        [
          -5,
          1,
          3,
          5,
          7,
          10
        ]
      ],
      "expected": 6
    },
    {
      "args": [
        42,
        [
          1,
          5,
          10
        ]
      ],
      "expected": 3
    },
    {
      "args": [
        5,
        [
          1,
          5,
          10
        ]
      ],
      "expected": 1
    },
    {
      "args": [
        7,
        [
          1,
          5,
          10
        ]
      ],
      "expected": 2
    },
    {
      "args": [
        3,
        [
          1,
          5,
          10
        ]
      ],
      "expected": 1
    },
    {
      "args": [
        -5,
        [
          1,
          5,
          10
        ]
      ],
      "expected": 0
    },
    {
      "args": [
        10,
        [
          -5,
          -1,
          3,
          5,
          7,
          10
        ]
      ],
      "expected": 5
    },
    {
      "args": [
        -100,
        [
          -5,
          -1,
          3,
          5,
          7,
          10
        ]
      ],
      "expected": 0
    },
    {
      "args": [
        0,
        [
          -5,
          -1,
          3,
          5,
          7,
          10
        ]
      ],
      "expected": 2
    },
    {
      "args": [
        100,
        []
      ],
      "expected": 0
    },
    {
      "args": [
        -100,
        []
      ],
      "expected": 0
    }
  ]
}