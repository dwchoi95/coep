{
  "id": "refactory_q2",
  "entry": "unique_day",
  "description": "Task: Unique dates and months\nImplement unique_day, unique_month and contains_unique_day.",
  "tests": [
    {
      "args": [
        "1",
        [
          [
            "January",
            "1"
          ],
          [
            "February",
            "1"
          ]
        ]
      ],
      "expected": false
    },
    {
      "args": [
        "January",
        [
          [
            "January",
            "1"
          ],
          [
            "January",
            "2"
          ]
        ]
      ],
      "expected": false,
      "entry": "unique_month"
    },
    {
      "args": [
        "January",
        [
          [
            "January",
            "1"
          ],
          [
            "February",
            "1"
          ]
        ]
      ],
      "expected": true,
      "entry": "unique_month"
    },
    {
      "args": [
        "January",
        [
          [
            "January",
            "1"
          ],
          [
            "January",
            "2"
          ]
        ]
      ],
      "expected": true,
      "entry": "contains_unique_day"
    },
    {
      "args": [
        "January",
        [
          [
            "January",
            "1"
          ],
          [
            "February",
            "1"
          ]
        ]
      ],
      "expected": false,
      "entry": "contains_unique_day"
    },
    {
      "args": [
        "February",
        [
          [
            "January",
            "10"
          ],
          [
            "February",
            "1"
          ],
          [
            "February",
            "10"
          ]
        ]
      ],
      "expected": true,
      "entry": "contains_unique_day"
    },
    {
      "args": [
        "3",
        [
          [
            "January",
            "1"
          ],
          [
            "January",
            "2"
          ]
        ]
      ],
      "expected": false
    },
    {
      "args": [
        "March",
        [
          [
            "January",
            "1"
          ],
          [
            "February",
            "1"
          ]
        ]
      ],
      "expected": false,
      "entry": "unique_month"
    },
    {
      "args": [
        "1",
        [
          [
            "January",
            "1"
          ],
          [
            "January",
            "2"
          ]
        ]
      ],
      "expected": true
    }
  ]
}