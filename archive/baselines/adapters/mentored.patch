+# --- adapter for stdin programs (CoEP benchmark) --------------------------------
+# The original patched ``input`` with ``side_effect=StringIO``, which returns each
+# line WITH its trailing newline, and exposed a StringIO without ``.buffer``.
+# Both make correct stdin programs fail. Here stdin is a real text stream shared
+# by ``input()``, ``sys.stdin`` and ``sys.stdin.buffer``; output is compared
+# judge-style (whitespace-normalized); ``exit()`` ends the program normally.
+def _make_stdin(text):
+    return io.TextIOWrapper(io.BytesIO(text.encode()), encoding="utf-8", newline=None)
+
+
+def _input_from(stream):
+    def _input(*_a):
+        line = stream.readline()
+        if line == "":
+            raise EOFError("EOF when reading a line")
+        return line.rstrip("\n")
+    return _input
+
+
+def _norm(text):
+    return " ".join(str(text).split())
+
+
 class UnitTestStatus:
     success = 'Success'
     error = 'Error'
